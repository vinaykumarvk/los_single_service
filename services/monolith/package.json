{
  "name": "los-monolith",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "ts-node --transpile-only ../../shared/libs/src/migrate.ts ./migrations",
    "build": "tsc -p tsconfig.json --noEmitOnError false || true",
    "start": "node dist/server.js",
    "outbox:dev": "ts-node-dev --respawn --transpile-only src/publisher.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@los/shared-libs": "workspace:*",
    "@supabase/supabase-js": "^2.86.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "1.4.5-lts.2",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^1.6.1"
  }
}
